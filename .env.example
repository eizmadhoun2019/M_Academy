# Masheed Academy — environment template. Copy to .env and replace every CHANGE_ME.
# Every variable is documented in docs/configuration.md; Hub variables live in
# docs/hub-contract.md §7 and are added by T-015. Never commit .env.

# --- Core (configuration.md §1) ---
DJANGO_SECRET_KEY=CHANGE_ME_generate_50_plus_chars
ACADEMY_ENV=development
ACADEMY_DEBUG=true
ACADEMY_ALLOWED_HOSTS=localhost,127.0.0.1,web,testserver
ACADEMY_CSRF_TRUSTED_ORIGINS=
ACADEMY_BUSINESS_TZ=UTC
ACADEMY_DEFAULT_LANGUAGE=ar
ACADEMY_SESSION_COOKIE_NAME=m_academy_sessionid
ACADEMY_SESSION_COOKIE_AGE=28800

# --- Data stores (configuration.md §2) ---
ACADEMY_DB_NAME=academy
ACADEMY_DB_USER=academy
ACADEMY_DB_PASSWORD=CHANGE_ME_db_password
ACADEMY_REDIS_URL=redis://redis:6379/0
ACADEMY_CELERY_BROKER_URL=redis://redis:6379/1
ACADEMY_CELERY_RESULT_URL=redis://redis:6379/2
ACADEMY_STORAGE_ENDPOINT=http://minio:9000
ACADEMY_STORAGE_BUCKET=academy-media-dev
ACADEMY_STORAGE_ACCESS_KEY=CHANGE_ME_minio_access_key
ACADEMY_STORAGE_SECRET_KEY=CHANGE_ME_minio_secret_key
ACADEMY_STORAGE_REGION=us-east-1
ACADEMY_STORAGE_PATH_STYLE=true

# --- Upload policy (configuration.md §3) ---
ACADEMY_UPLOAD_MAX_VIDEO_BYTES=2147483648
ACADEMY_UPLOAD_MAX_IMAGE_BYTES=10485760
ACADEMY_UPLOAD_MAX_DOCUMENT_BYTES=26214400
ACADEMY_UPLOAD_MAX_DURATION_SECONDS=14400
ACADEMY_UPLOAD_URL_TTL_SECONDS=900
ACADEMY_PLAYBACK_URL_TTL_SECONDS=300

# --- Video pipeline (configuration.md §4) ---
ACADEMY_HLS_RENDITIONS=360p,720p
ACADEMY_HLS_SEGMENT_SECONDS=6
ACADEMY_TRANSCODE_TIMEOUT_SECONDS=3600
ACADEMY_TRANSCODE_ATTEMPTS=2

# --- Limits (configuration.md §5–§6) ---
ACADEMY_PAGE_SIZE=25
ACADEMY_MAX_PAGE_SIZE=100
ACADEMY_API_BODY_LIMIT_BYTES=2097152

# --- Email ---
ACADEMY_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
ACADEMY_EMAIL_HOST=mailhog
ACADEMY_EMAIL_PORT=1025

# --- Logging ---
ACADEMY_LOG_LEVEL=INFO
